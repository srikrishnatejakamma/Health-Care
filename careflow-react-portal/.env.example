# Same-origin API requests are proxied to the Go server during Vite development.
# API_PROXY_TARGET=http://127.0.0.1:18080
# Configure all three to enable OIDC Authorization Code + PKCE sign-in.
# VITE_OIDC_AUTHORITY=https://identity.example.com
# VITE_OIDC_CLIENT_ID=careflow-portal
# VITE_OIDC_SCOPE=openid profile healthcare-api
