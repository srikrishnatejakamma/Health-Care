APP_ENV=development
HTTP_ADDR=127.0.0.1:8080
STORE=memory
# Generate a random secret with scripts/dev.ps1 or your secret manager.
AUTH_KEY=replace-with-a-random-secret-at-least-32-bytes-long
AUTH_ISSUER=healthcare-local
AUTH_AUDIENCE=healthcare-api
# Set this instead of AUTH_KEY to accept RS256 identity-provider tokens.
# AUTH_PUBLIC_KEY_FILE=config/issuer-public.pem
DEMO_SEED=true
WORKER_ENABLED=true
WORKERS=4
MEMORY_BUDGET_MB=256
DB_MAX_CONNECTIONS=16
# PostgreSQL runtime login must inherit healthcare_runtime and must not own tables.
# DATABASE_URL=postgres://healthcare_app:local-app-password@localhost:5432/healthcare?sslmode=disable
# MIGRATION_DATABASE_URL=postgres://postgres:local-admin-password@localhost:5432/healthcare?sslmode=disable
